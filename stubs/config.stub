import env from '#start/env'
import mail from '@adonisjs/mail/services/main'
import { defineConfig } from 'adonisjs-auth-mail'
import EmailVerification from '#models/email_verification'
import PasswordReset from '#models/password_reset'

const authMailConfig = defineConfig({
  secret: env.get('APP_KEY'),
  mailer: mail,
  from: env.get('MAIL_FROM'),

  /** Token lifetimes in seconds */
  verificationExpiresIn: 60 * 60 * 24,
  resetExpiresIn: 60 * 60,

  /** Links placed in the emails; point them at your frontend or at the controller routes */
  verificationUrl: (token) => `${env.get('APP_URL')}/email/verify/${token}`,
  resetUrl: (token) => `${env.get('APP_URL')}/password/reset/${token}`,

  /** Track sent messages */
  verificationStore: {
    async create(r) {
      await EmailVerification.create(r as any)
    },
    async markVerified(tokenHash, at) {
      await EmailVerification.query().where('tokenHash', tokenHash).update({ verifiedAt: at })
    },
  },
  resetStore: {
    async create(r) {
      await PasswordReset.create(r as any)
    },
    async markUsed(tokenHash, at) {
      await PasswordReset.query().where('tokenHash', tokenHash).update({ usedAt: at })
    },
  },
})

export default authMailConfig
