import type { HttpContext } from '@adonisjs/core/http'
import vine from '@vinejs/vine'
import User from '#models/user'
import authMailConfig from '#config/auth_mail'
import { AuthMail } from 'adonisjs-auth-mail'

const authMail = new AuthMail(authMailConfig, (id) => User.find(id))

const forgotValidator = vine.compile(vine.object({ email: vine.string().email() }))
const resetValidator = vine.compile(vine.object({ password: vine.string().minLength(8) }))

export default class PasswordResetController {
  /** POST /password/forgot - always responds the same to avoid leaking accounts */
  async forgot({ request, response }: HttpContext) {
    const { email } = await request.validateUsing(forgotValidator)
    await authMail.sendPasswordReset(email, (e) => User.findBy('email', e))
    return response.accepted({ message: 'If the account exists, an email was sent' })
  }

  /** POST /password/reset/:token */
  async reset({ params, request, response }: HttpContext) {
    const { password } = await request.validateUsing(resetValidator)
    const user = await authMail.resetPassword(params.token, async (u) => {
      u.password = password
      await u.save()
    })
    if (!user) return response.badRequest({ message: 'Invalid or expired token' })
    return { message: 'Password updated' }
  }
}
