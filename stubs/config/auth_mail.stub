{{{
  exports({ to: app.configPath('auth_mail.ts') })
}}}
import env from '#start/env'
import mail from '@adonisjs/mail/services/main'
import { defineConfig } from 'adonisjs-auth-mail'
import PasswordReset from '#models/password_reset'

const authMailConfig = defineConfig({
  secret: env.get('APP_KEY'),
  mailer: mail,
  from: env.get('MAIL_FROM'),

  /** Token lifetimes in seconds */
  verificationExpiresIn: 60 * 60 * 24,
  resetExpiresIn: 60 * 60,

  /** Links placed in the emails; point them at your frontend or at the controller routes */
  verificationUrl: (token) => `${env.get('APP_URL')}/email/verify/${token}`,
  resetUrl: (token) => `${env.get('APP_URL')}/password/reset/${token}`,

  verificationMessage(message, url, user) {
    message
      .subject('Verify your email address')
      .htmlView('emails/auth_mail/verify_email', { url, user })
      .textView('emails/auth_mail/verify_email_text', { url, user })
  },
  resetMessage(message, url, user) {
    message
      .subject('Reset your password')
      .htmlView('emails/auth_mail/reset_password', { url, user })
      .textView('emails/auth_mail/reset_password_text', { url, user })
  },

  resetStore: {
    async create(r) {
      await PasswordReset.create(r as any)
    },
    async consume(tokenHash, at) {
      const updated = await PasswordReset.query()
        .where('tokenHash', tokenHash)
        .whereNull('usedAt')
        .where('expiresAt', '>', at)
        .update({ usedAt: at })
      return updated > 0
    },
  },
})

export default authMailConfig
