{
  "name": "adonisjs-auth-mail",
  "version": "0.1.0",
  "description": "Email verification and password reset for AdonisJS v7, built on @adonisjs/mail and @adonisjs/auth",
  "author": {
    "name": "Guo Yunhe",
    "email": "i@guoyunhe.me"
  },
  "license": "AGPL-3.0-or-later",
  "homepage": "https://github.com/guoyunhe/adonisjs-auth-mail#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guoyunhe/adonisjs-auth-mail.git"
  },
  "bugs": {
    "url": "https://github.com/guoyunhe/adonisjs-auth-mail/issues"
  },
  "keywords": [
    "adonisjs",
    "adonisjs-v7",
    "authentication",
    "email-verification",
    "password-reset"
  ],
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "files": [
    "build",
    "stubs"
  ],
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": "./build/index.js",
    "./services/email_verification": "./build/services/email_verification.js",
    "./services/password_reset": "./build/services/password_reset.js",
    "./verified_middleware": "./build/verified_middleware.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.spec.ts"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.14.0",
      "onFail": "error"
    }
  },
  "peerDependencies": {
    "@adonisjs/auth": "^10.0.0",
    "@adonisjs/core": "^7.0.0",
    "@adonisjs/lucid": "^22.0.0",
    "@adonisjs/mail": "^10.0.0",
    "@vinejs/vine": "^4.0.0",
    "edge.js": "^6.0.1",
    "luxon": "^3.7.0"
  },
  "devDependencies": {
    "@adonisjs/core": "^7.0.0",
    "@types/luxon": "^3.7.6",
    "@types/node": "^22.20.5",
    "luxon": "^3.7.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
